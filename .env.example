# 服务端口。必须与前端协同房间默认地址（ws://localhost:8787/ws）一致。
PORT=8787

# 持久化数据目录（存放蓝图快照与协同房间状态，默认 .atlas-data）
ATLAS_DATA_DIR=.atlas-data

# 可选：服务端密钥注入代理配置（密钥仅留在服务端，绝不下发前端）
PROXY_UPSTREAM_BASE_URL=
PROXY_ALLOWED_HOSTS=httpbin.org,api.github.com
PROXY_API_KEY=
PROXY_API_KEY_HEADER=Authorization

# 保存后端蓝图架构所需的管理员密钥（留空则禁止所有远程保存，仅允许控件内置 API 访问）
BLUEPRINT_SAVE_KEY=change-me-save-key

# ── 鉴权与限流配置 ─────────────────────────────────────────────────────────
# 无状态 HMAC-SHA256 会话令牌签发密钥（公网部署时须与下方 PROXY_CLIENT_TOKEN 搭配设置；单配本项不会允许无凭证领令牌）
AUTH_SESSION_SECRET=

# /api/proxy、PDF 与 /ws 调用方鉴权令牌（可选，配置上游密钥部署公网时强烈建议开启）
PROXY_CLIENT_TOKEN=
PROXY_RATE_LIMIT_PER_MIN=30

# 前端注入的调用方令牌（构建期常量；若启用 PROXY_CLIENT_TOKEN，用于换取 /api/auth/session 短期签名令牌）
VITE_PROXY_CLIENT_TOKEN=

# ── 运行模式开关 ───────────────────────────────────────────────────────────
# 外部后端 WebSocket 地址，形如 wss://your-host.example.com/ws 或 ws://localhost:8787/ws。
#   留空 → 纯静态模式：/api/* 在浏览器内执行（数据存 IndexedDB）
#   填了 → 连后端模式：/api/* 经 WebSocket 原生二进制 RPC 转发到服务端
VITE_BACKEND_WS_URL=

# 浏览器模式下的代理白名单与限流
VITE_PROXY_ALLOWED_HOSTS=httpbin.org,api.github.com
VITE_PROXY_RATE_LIMIT_PER_MIN=30
