# 服务端口（与前端默认协同地址 ws://localhost:8787/ws 一致）
PORT=8787

# 统一房间数据目录（REST 与 WS 共用 <ATLAS_DATA_DIR>/rooms/<room>.json 单一事实源）
ATLAS_DATA_DIR=.atlas-data

# ── 仅留 Node 侧读取的密钥（绝不注入前端包） ──────────────────────────────
# 管理员发布蓝图密钥（由管理员在界面输入校验，留空则禁止远程发布）
BLUEPRINT_SAVE_KEY=change-me-save-key

# 防自动化/防刷会话令牌签名密钥（仅 Node 读取；启用后 POST /api/auth/session 按限流与 Origin 白名单签发 1 小时 HttpOnly Cookie）
AUTH_SESSION_SECRET=

# 允许跨源访问的浏览器 Origin 白名单（逗号分隔，例如 https://yourname.github.io）
CORS_ALLOWED_ORIGINS=

# 可选：服务端代理配置与上游密钥（密钥仅在 Node 侧注入）
PROXY_UPSTREAM_BASE_URL=
PROXY_ALLOWED_HOSTS=httpbin.org,api.github.com
PROXY_API_KEY=
PROXY_API_KEY_HEADER=Authorization
PROXY_RATE_LIMIT_PER_MIN=30

# ── 前端构建期公开配置（不含任何密钥） ────────────────────────────────────
# 外部后端 WebSocket 地址（留空 = 纯前端匿名静态模式；填了 = 连后端模式，支持 REST / WS / WebRTC 三通道）
VITE_BACKEND_WS_URL=
VITE_PROXY_ALLOWED_HOSTS=httpbin.org,api.github.com
VITE_PROXY_RATE_LIMIT_PER_MIN=30

# 出站代理管理密钥（配置 PROXY_API_KEY 时强烈建议设置，与匿名会话令牌解耦）
PROXY_ACCESS_KEY=

# 是否信任反向代理传入的 X-Forwarded-For（仅在 Nginx/Cloudflare 后部署时设为 true）
TRUST_PROXY=false
