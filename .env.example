# 服务端口。必须与前端协同房间默认地址（App.tsx 里的 ws://localhost:8787/ws）一致，
# 否则 npm run dev 起来了但前端连不上协同房间。改这里的话记得同步改前端那个默认值。
PORT=8787
# 可选：服务端密钥注入代理配置（密钥仅留在服务端，绝不下发前端）
PROXY_UPSTREAM_BASE_URL=
PROXY_ALLOWED_HOSTS=httpbin.org,api.github.com
PROXY_API_KEY=
PROXY_API_KEY_HEADER=Authorization
# 保存后端蓝图架构所需的管理员密钥（留空则禁止所有远程保存，仅允许控件内置 API 访问）
BLUEPRINT_SAVE_KEY=change-me-save-key

# /api/proxy 调用方鉴权令牌（可选，配置上游密钥部署公网时强烈建议开启）与每分钟限流
# 注意：若在此设置，前端构建时必须同时设置 VITE_PROXY_CLIENT_TOKEN 为相同值，
# 否则 src/core/apiClient.ts 不会带上 X-Proxy-Token，所有代理/上传/解包请求都会被 401。
PROXY_CLIENT_TOKEN=
PROXY_RATE_LIMIT_PER_MIN=30

# 前端注入的调用方令牌（构建期常量，需与上面 PROXY_CLIENT_TOKEN 相同）
VITE_PROXY_CLIENT_TOKEN=

# ── 运行模式开关 ───────────────────────────────────────────────────────────
# 外部后端 WebSocket 地址，形如 wss://your-host.example.com/ws 或 ws://localhost:8787/ws。
#
#   留空 → 纯静态模式：/api/* 在浏览器内执行（与后端同一份 src/core/apiCore.ts，
#          数据存 IndexedDB）。可离线演示，但没有安全边界——用户改前端就能绕。
#   填了 → 连后端模式：/api/* 经 WebSocket 转发到该地址，由服务端执行同一份 apiCore，
#          此时白名单、限流、SSRF 防护、鉴权全部生效。
#
# GitHub Pages 是静态托管，线上若留空则永远是纯静态模式。要真正协同请部署
# server/server.ts 并把它的地址填在这里，然后重新构建。
VITE_BACKEND_WS_URL=

# 浏览器模式下的代理白名单与限流（服务端模式读的是上面不带 VITE_ 前缀的那组）
VITE_PROXY_ALLOWED_HOSTS=httpbin.org,api.github.com
VITE_PROXY_RATE_LIMIT_PER_MIN=30
